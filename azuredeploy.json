{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Azure Logic App - Sentinel Data Ingestion Proxy",
    "description": "Deploy a Logic App that acts as an HTTPS proxy for Azure Sentinel data ingestion, uses Logic App's built-in SAS authentication and Azure Log Analytics Data Collector connector",
    "author": "DataElicit Solutions Pvt. Ltd.",
    "dateUpdated": "2024-01-15"
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "[concat('reco-logic-app-sentinel-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace ID for Azure Sentinel"
      }
    },
    "workspaceKey": {
      "type": "securestring",
      "metadata": {
        "description": "Log Analytics workspace primary or secondary key"
      }
    },
    "logType": {
      "type": "string",
      "defaultValue": "RecoAlert",
      "metadata": {
        "description": "Custom log table name in Log Analytics (will have '_CL' suffix added automatically)"
      }
    },
    "timeoutInSeconds": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Timeout for Log Analytics API calls in seconds"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Application": "Reco Logic App - Sentinel Integration",
        "ManagedBy": "ARM Template",
        "Environment": "Production",
        "Owner": "IT Operations",
        "Project": "Reco - Azure Sentinel Data Ingestion"
      },
      "metadata": {
        "description": "Tags to assign to all resources"
      }
    }
  },
  "variables": {
    "connectionName": "[concat(parameters('logicAppName'), '-loganalytics-connection')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "Azure Log Analytics Data Collector",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azureloganalyticsdatacollector')]"
        },
        "parameterValues": {
          "username": "[parameters('workspaceId')]",
          "password": "[parameters('workspaceKey')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/schemas/2016-06-01/Microsoft.Logic.json",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "logType": {
              "type": "string",
              "defaultValue": "[parameters('logType')]"
            },
            "timeoutInSeconds": {
              "type": "int",
              "defaultValue": "[parameters('timeoutInSeconds')]"
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {},
                "method": "POST"
              },
              "operationOptions": "EnableSchemaValidation"
            }
          },
          "actions": {
            "Initialize_Headers": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "RequestHeaders",
                    "type": "object",
                    "value": "@triggerOutputs()['headers']"
                  }
                ]
              },
              "runAfter": {}
            },
            "Initialize_Body": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "RequestBody",
                    "type": "string",
                    "value": "@{triggerBody()}"
                  }
                ]
              },
              "runAfter": {
                "Initialize_Headers": ["Succeeded"]
              }
            },
            "Initialize_Request_Id": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "RequestId",
                    "type": "string",
                    "value": "@workflow()['run']['name']"
                  }
                ]
              },
              "runAfter": {
                "Initialize_Body": ["Succeeded"]
              }
            },
            "Log_Request_Start": {
              "type": "Compose",
              "inputs": {
                "message": "Processing request for Azure Sentinel ingestion",
                "timestamp": "@utcnow()",
                "requestId": "@variables('RequestId')"
              },
              "runAfter": {
                "Initialize_Request_Id": ["Succeeded"]
              }
            },
            "Prepare_Log_Analytics_Data": {
              "type": "Compose",
              "inputs": {
                "timestamp": "@utcnow()",
                "requestId": "@variables('RequestId')",
                "sourceIP": "@coalesce(variables('RequestHeaders')?['x-forwarded-for'], variables('RequestHeaders')?['x-real-ip'], 'unknown')",
                "userAgent": "@coalesce(variables('RequestHeaders')?['user-agent'], 'unknown')",
                "originalHost": "@coalesce(variables('RequestHeaders')?['host'], 'unknown')",
                "requestMethod": "POST",
                "requestData": "@json(coalesce(variables('RequestBody'), '{}'))",
                "proxyVersion": "1.0",
                "environment": "@coalesce(variables('RequestHeaders')?['x-environment'], 'unknown')"
              },
              "runAfter": {
                "Log_Request_Start": ["Succeeded"]
              }
            },
            "Send_Data_to_Log_Analytics": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@outputs('Prepare_Log_Analytics_Data')",
                "path": "/api/logs",
                "queries": {
                  "Log-Type": "@parameters('logType')",
                  "time-generated-field": "timestamp"
                },
                "headers": {
                  "Log-Type": "@parameters('logType')"
                }
              },
              "runAfter": {
                "Prepare_Log_Analytics_Data": ["Succeeded"]
              }
            },
            "Handle_Success_Response": {
              "type": "Response",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json",
                  "X-Proxy-Status": "success",
                  "X-Request-Id": "@variables('RequestId')",
                  "X-Log-Analytics-Status": "ingested"
                },
                "body": {
                  "status": "success",
                  "message": "Data successfully sent to Azure Sentinel / Log Analytics",
                  "requestId": "@variables('RequestId')",
                  "timestamp": "@utcnow()",
                  "logType": "@concat(parameters('logType'), '_CL')"
                }
              },
              "runAfter": {
                "Send_Data_to_Log_Analytics": ["Succeeded"]
              }
            },
            "Handle_Log_Analytics_Failure": {
              "type": "Response",
              "inputs": {
                "statusCode": 502,
                "headers": {
                  "Content-Type": "application/json",
                  "X-Proxy-Status": "log-analytics-failure",
                  "X-Request-Id": "@variables('RequestId')"
                },
                "body": {
                  "error": "Failed to send data to Log Analytics",
                  "details": "The Log Analytics workspace connection failed or data format was invalid",
                  "requestId": "@variables('RequestId')",
                  "timestamp": "@utcnow()"
                }
              },
              "runAfter": {
                "Send_Data_to_Log_Analytics": ["Failed", "TimedOut"]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azureloganalyticsdatacollector": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azureloganalyticsdatacollector')]"
              }
            }
          },
          "logType": {
            "value": "[parameters('logType')]"
          },
          "timeoutInSeconds": {
            "value": "[parameters('timeoutInSeconds')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "triggerEndpointUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/manual'), '2019-05-01').value]",
      "metadata": {
        "description": "The HTTPS endpoint URL for the Logic App trigger (includes SAS authentication)"
      }
    },
    "targetLogTable": {
      "type": "string",
      "value": "[concat(parameters('logType'), '_CL')]"
    },
    "workspaceId": {
      "type": "string",
      "value": "[parameters('workspaceId')]"
    },
    "connectionName": {
      "type": "string",
      "value": "[variables('connectionName')]"
    }
  }
} 
